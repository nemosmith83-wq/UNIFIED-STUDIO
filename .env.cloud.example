# Copy to .env.cloud for Docker Compose deployments. Keep .env.cloud private.
# Put real provider keys only in your hosting dashboard or private .env.cloud file.

# Container
PORT=8000
UNIFIED_HOST=0.0.0.0
UNIFIED_DB_PATH=/app/data/unified.db
UNIFIED_AUTH_DB_PATH=/app/data/auth.db
APP_HTTP_PORT=8080

# Safe defaults for public hosting
ALLOW_REGISTRATION=false
COOKIE_SECURE_ONLY=true
ENABLE_CODE_EXECUTION=false

# Cloud chat: choose a provider for which you have a valid key.
# Ollama is local-only by default and will NOT work in a cloud container
# unless you separately host Ollama and set OLLAMA_URL to a reachable service.
LLM_PROVIDER=groq
LLM_FALLBACKS=groq,openrouter,pollinations
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
POLLINATIONS_MODEL=openai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Image generation (optional; providers can impose rate limits or change access)
HORDE_API_KEY=0000000000
